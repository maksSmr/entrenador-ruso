# Copia a .env. NUNCA subas .env a Git (ya está en .gitignore).

# --- Base de datos ---
# Opción A (recomendada): copia el connection string de Neon o Supabase.
# Opción B (PostgreSQL local): postgresql://postgres:TU_CLAVE@localhost:5432/entrenador_ruso
DATABASE_URL=postgresql://usuario:contrasena@host:5432/entrenador_ruso
# Neon/Supabase = true. Postgres local = false.
DB_SSL=true

# --- API ---
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Los tokens de sesión duran 7 días; puedes acortarlo en pruebas (por ejemplo 1h).
JWT_EXPIRA=7d
# En producción usa el puerto que asigne Render (ej. 10000). El valor por defecto es 3000.
PORT=3000
# Origen del frontend: se añade a CORS. En local deja el valor de abajo.
FRONTEND_URL=http://localhost:5173
# development | production. Fuera de production los correos se simulan en consola.
NODE_ENV=development

# --- Correo (Resend) ---
# El registro ya no depende del correo. Sin clave o fuera de production se simula en consola.
# Se usa para restablecer contraseña y reenvíos manuales; no se necesita Gmail ni Nodemailer.
RESEND_API_KEY=
CORREO_REMITENTE=Entrenador de Idiomas <onboarding@resend.dev>

# --- Gemini (generación de tarjetas desde PDF/DOCX) ---
# Nunca lo pongas en el frontend: solo lo lee el backend.
GEMINI_API_KEY=
# Valor por defecto: gemini-3.8-flash. Para ver los modelos de tu clave:
# node scripts/listarModelosGemini.js
GEMINI_MODELO=gemini-3.8-flash

# --- Stripe (modo prueba) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECIO_PRO=
